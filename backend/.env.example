# Hugging Face Configuration
HF_TOKEN=your_huggingface_token_here

# Optional: Hugging Face Inference Endpoints for Video Generation
# Create these at https://huggingface.co/inference-endpoints
HF_SVD_IMG2VID_ENDPOINT=
HF_SVD_XT_ENDPOINT=

# Generation Engine Selection
# Options: "hf" (Hugging Face Inference API) or "local" (local diffusers)
ENGINE_IMAGE=hf
ENGINE_VIDEO=hf

# Default Models
IMAGE_MODEL=sd-turbo
VIDEO_MODEL=svd-img2vid

# Generation Settings
IMAGE_SIZE=768
IMAGE_STEPS=4
VIDEO_RES=512
VIDEO_FRAMES=12
VIDEO_STEPS=8

# Data Directory
DATA_DIR=./data

# API Configuration
API_PORT=8000

# Test Configuration
TEST_TIMEOUT_SEC=1800
