# API Configuration
API_PORT=8000
WEB_PORT=3000

# Data Directory
DATA_DIR=./data

# GPU Configuration
USE_GPU_IF_AVAILABLE=true

# Model Configuration
# Image Models: sd-turbo (GPU fast), sd15 (GPU balanced), onnx (CPU fallback)
IMAGE_MODEL=sd-turbo
# Video Model: svd-xt (works on both GPU and CPU with different settings)
VIDEO_MODEL=svd-xt
# Embeddings Model
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
# Caption Model
CAPTION_MODEL=blip-base

# RAG Configuration
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5

# Image Generation Settings
IMAGE_SIZE=256
IMAGE_STEPS=8
IMAGE_GUIDANCE_SCALE=7.5

# Video Generation Settings
VIDEO_RES=256
VIDEO_FRAMES=8
VIDEO_STEPS=8
VIDEO_SECONDS=2
VIDEO_FPS=8

# Test Configuration
TEST_TIMEOUT_SEC=1800

# Safety Configuration
ENABLE_SAFETY_CHECKS=true
ENABLE_WATERMARK=true

# Database
DATABASE_PATH=./data/app.db

# Logging
LOG_LEVEL=INFO
